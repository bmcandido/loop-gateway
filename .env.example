# Copie para .env.<id-do-projeto-firebase> (ex.: .env.portal-financeiro-c18b7).
# Não coloque segredos aqui: vão no Secret Manager
#   firebase functions:secrets:set PORTAL_GATEWAY_SECRET
#   firebase functions:secrets:set PORTAL_SUPABASE_SECRET_KEY

# CNPJ do cliente, só dígitos (linha de `clientes` no Supabase)
PORTAL_CNPJ=00000000000000

# Projeto Supabase com `clientes` (X-Token, tipoIntegracao) e `loopapp`
# (clienteId, clienteSecret e urlBase de produção/teste)
PORTAL_SUPABASE_URL=https://<ref>.supabase.co

# Origens do app web autorizadas, separadas por vírgula
PORTAL_ORIGENS_WEB=https://pentagono-cliente.web.app,https://pentagono-cliente.firebaseapp.com
