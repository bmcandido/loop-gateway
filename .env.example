# Gateway ÚNICO dos apps Loop: atende TODOS os clientes. Nada aqui é por cliente
# (o cliente vem da licença assinada que o app envia em X-Loop-Licenca).
# Copie para .env.<id-do-projeto-firebase>. Documentação: loop-admin/docs/licenciamento/
#
# Segredos (Secret Manager, uma vez por projeto Firebase):
#   firebase functions:secrets:set PORTAL_SUPABASE_SECRET_KEY
#   firebase functions:secrets:set PORTAL_GATEWAY_CHAVE_PRIVADA --data-file <loop-gateway-AAAA-MM.pem>
#     (gerada no Loop Mais: node scripts/gerar-chave-gateway.js)

# Projeto Supabase com clientes, clientesProdutos, loopapp e a RPC licenca_status
PORTAL_SUPABASE_URL=https://zvncvdlfyeyktnuzxvlc.supabase.co

# kid da chave do gateway (a chave pública com esse kid precisa estar nos add-ons)
PORTAL_GATEWAY_KID=loop-gateway-2026-11

# Opcionais
# PORTAL_FIREBASE_PROJETOS=projeto-a,projeto-b   # login aceito (vazio = só o projeto do gateway)
# PORTAL_ORIGENS_WEB=https://app.cliente.com.br  # travar CORS (vazio = qualquer origem; não há cookie)
# PORTAL_PRODUTO=LoopPortal
